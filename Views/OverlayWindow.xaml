<Window x:Class="HornMelodyTimer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HornMelodyTimer.Converters"
        Title="MHXX 狩獵笛旋律計時器－疊加介面"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <converters:NoteCodeToImageConverter x:Key="NoteIconConverter"/>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF2D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#B82C1D17"/>
            <Setter Property="Foreground" Value="#FFF2D8"/>
            <Setter Property="BorderBrush" Value="#80554237"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#CC70282C"/>
            <Setter Property="Foreground" Value="#FFFFE44D"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <Border Background="#B8171412" BorderBrush="#AA765643" BorderThickness="1"
            CornerRadius="5" Padding="6">
        <StackPanel>
            <Grid Height="34" Background="#99201713" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="返回完整介面" Click="Return_Click"
                        Background="#CC793238" Foreground="#FFFFF2D8"
                        BorderBrush="#CCB68B54" Padding="10,3" Margin="2"/>
                <TextBlock Grid.Column="1" Text="拖曳此處移動計時器"
                           Foreground="#D9C4AA" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <CheckBox x:Name="RegionIndicatorCheckBox" Grid.Column="2"
                          Content="顯示框選位置" Foreground="#FFF2D8"
                          VerticalAlignment="Center" Margin="8,0"
                          Checked="RegionIndicator_Changed"
                          Unchecked="RegionIndicator_Changed"/>
                <Button Grid.Column="3" Content="×" Click="Return_Click"
                        Background="Transparent" Foreground="#FFF2D8"
                        BorderBrush="Transparent" Padding="10,0" Margin="0,0,2,0"/>
            </Grid>
            <DataGrid x:Name="SongsGrid" ItemsSource="{Binding}"
                      Width="980" IsReadOnly="True" CanUserSortColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AutoGenerateColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="#A8241914" Foreground="#FFF2D8"
                      RowBackground="#B82C1D17"
                      AlternatingRowBackground="#B835231B"
                      HorizontalGridLinesBrush="#80554237"
                      BorderBrush="#80554237"
                      FontSize="18" RowHeight="42"
                      SelectionUnit="CellOrRowHeader">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="旋律" IsReadOnly="True" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding NoteCodes}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Converter={StaticResource NoteIconConverter}}"
                                                   Height="30" Stretch="Uniform" Margin="1,0,4,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="效果" IsReadOnly="True" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{Binding DisplayColor}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="DurationColumn" Header="初次效果"
                                        Binding="{Binding DurationSeconds}" Width="100"/>
                    <DataGridTextColumn x:Name="ExtensionColumn" Header="延長"
                                        Binding="{Binding ExtensionSeconds}" Width="85"/>
                    <DataGridTextColumn x:Name="MaestroDurationColumn" Header="吹笛名人初次"
                                        Binding="{Binding MaestroDurationSeconds}" Width="140"/>
                    <DataGridTextColumn x:Name="MaestroExtensionColumn" Header="吹笛名人延長"
                                        Binding="{Binding MaestroExtensionSeconds}" Width="140"/>
                    <DataGridTextColumn x:Name="RemainingColumn" Header="剩餘時間"
                                        Binding="{Binding RemainingText}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</Window>
