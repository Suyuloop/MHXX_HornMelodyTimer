<Window x:Class="HornMelodyTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HornMelodyTimer.Converters"
        Title="MHXX 狩獵笛旋律計時器" Height="740" Width="1120"
        MinHeight="600" MinWidth="860" Background="#171412" Foreground="#F4E7D1">
    <Window.Resources>
        <converters:NoteCodeToImageConverter x:Key="NoteIconConverter"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#241914"/>
            <Setter Property="Foreground" Value="#F4E7D1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="RowBackground" Value="#2C1D17"/>
            <Setter Property="AlternatingRowBackground" Value="#35231B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#554237"/>
            <Setter Property="BorderBrush" Value="#554237"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#70282C"/>
                        <Setter Property="Foreground" Value="#FFE44D"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#201713"/>
            <Setter Property="Foreground" Value="#FFF2D8"/>
            <Setter Property="BorderBrush" Value="#765643"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#793238"/>
            <Setter Property="Foreground" Value="#FFF2D8"/>
            <Setter Property="BorderBrush" Value="#B68B54"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2D8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF8E8"/>
            <Setter Property="Foreground" Value="#302018"/>
            <Setter Property="BorderBrush" Value="#B68B54"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#3B241B"/>
            <Setter Property="Foreground" Value="#FFF2D8"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#156082"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0D59B"/>
                    <Setter Property="Foreground" Value="#281710"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="MHXX 狩獵笛旋律增益計時器" FontSize="24" FontWeight="Bold"
                   Foreground="#FFE44D" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="框選遊戲畫面" Click="SelectRegion_Click"/>
            <Button Content="切換疊加介面" Click="ToggleOverlay_Click"/>
            <Button Content="重置效果時間" Click="ResetEffects_Click"/>
            <CheckBox x:Name="ShowRegionIndicatorCheckBox" Content="顯示框選位置"
                      IsChecked="True" VerticalAlignment="Center"
                      Checked="RegionIndicator_Changed" Unchecked="RegionIndicator_Changed"
                      Margin="0,0,12,0"/>
            <TextBlock x:Name="RegionStatus" VerticalAlignment="Center" Text="尚未選取畫面範圍"/>
        </StackPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox x:Name="MaestroCheckBox" Content="已裝備 吹笛名人"
                      VerticalAlignment="Center" Margin="0,0,24,0"
                      Checked="Maestro_Changed" Unchecked="Maestro_Changed"/>
        </WrapPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="譜面：" Foreground="#E8C89D" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ScoreSelector" Width="270" Height="36"
                      SelectionChanged="ScoreSelector_SelectionChanged"
                      ItemsSource="{Binding ScoreOptions}"
                      SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding NoteCodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#25211C" Padding="2" Margin="1,0,3,0">
                                        <Image Source="{Binding Converter={StaticResource NoteIconConverter}}"
                                               Height="26" Stretch="Uniform"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="旋律效果與時間設定（秒）— 可依參考頁核對後修改"
                       FontSize="18" Foreground="#E8C89D" Margin="0,0,0,6"/>
            <Expander Grid.Row="1" Header="時間欄位設定" IsExpanded="False"
                      Foreground="#FFE44D" Margin="0,0,0,6">
                <CheckBox x:Name="ShowTimeColumnsCheckBox"
                          Content="顯示右側時間設定與剩餘時間"
                          FontSize="18"
                          Checked="TimeColumnsVisibility_Changed"
                          Unchecked="TimeColumnsVisibility_Changed"
                          Margin="6,2,0,8"/>
            </Expander>
            <DataGrid x:Name="SongsGrid" Grid.Row="2" ItemsSource="{Binding Songs}"
                      IsReadOnly="False" CanUserSortColumns="False"
                      SelectionUnit="CellOrRowHeader" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="旋律" IsReadOnly="True" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding NoteCodes}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Converter={StaticResource NoteIconConverter}}"
                                                   Height="30" Stretch="Uniform" Margin="1,0,4,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="效果" IsReadOnly="True" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{Binding DisplayColor}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="DurationColumn" Header="初次效果"
                                        Binding="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus}" Width="100"/>
                    <DataGridTextColumn x:Name="ExtensionColumn" Header="延長"
                                        Binding="{Binding ExtensionSeconds, UpdateSourceTrigger=LostFocus}" Width="85"/>
                    <DataGridTextColumn x:Name="MaestroDurationColumn" Header="吹笛名人初次"
                                        Binding="{Binding MaestroDurationSeconds, UpdateSourceTrigger=LostFocus}" Width="140"/>
                    <DataGridTextColumn x:Name="MaestroExtensionColumn" Header="吹笛名人延長"
                                        Binding="{Binding MaestroExtensionSeconds, UpdateSourceTrigger=LostFocus}" Width="140"/>
                    <DataGridTextColumn x:Name="RemainingColumn" Header="剩餘時間"
                                        Binding="{Binding RemainingText}" IsReadOnly="True" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="18" Foreground="#C7AD91"
                       Text="辨識範圍只框音符圖示（最多四列），不要包含標題或右側效果文字；彩色外框標示目前擷取位置。複合效果會依遊戲提示列合併計次。"/>
        </Grid>
        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#D9C4AA" TextWrapping="Wrap"
                   Text="先框選遊戲畫面左下角的音符提示列；彩色外框會持續標示辨識範圍。"/>
    </Grid>
</Window>
